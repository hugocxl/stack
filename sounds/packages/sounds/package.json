{
  "name": "@hugocxl/sounds",
  "version": "0.1.0",
  "description": "Tactile interface sounds for the web, synthesized live with Web Audio. No audio files.",
  "keywords": [
    "sounds",
    "ui sounds",
    "interface",
    "haptics",
    "feedback",
    "web audio",
    "click",
    "typing"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "skills",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Hugo Corta (https://hugocxl.me)",
  "homepage": "https://hugocxl.github.io/stack/sounds/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugocxl/stack.git",
    "directory": "sounds/packages/sounds"
  },
  "bugs": "https://github.com/hugocxl/stack/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "prepack": "cp ../../LICENSE ../../NOTICE . && pnpm run build"
  }
}
