{
  "name": "@hugocxl/stack",
  "version": "0.1.0",
  "description": "Set up any project so every AI agent uses the @hugocxl stack (design system, icons, vectors and sounds) the same way.",
  "keywords": [
    "agents",
    "agent skills",
    "AGENTS.md",
    "claude code",
    "design system",
    "icons",
    "lint"
  ],
  "type": "module",
  "bin": {
    "stack": "bin/stack.mjs"
  },
  "exports": {
    ".": "./src/check.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Hugo Corta (https://hugocxl.me)",
  "homepage": "https://github.com/hugocxl/stack#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugocxl/stack.git"
  },
  "bugs": "https://github.com/hugocxl/stack/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@hugocxl/design-system": "^0.2.10",
    "@hugocxl/icons": "^0.2.29",
    "@hugocxl/sounds": "^0.1.3",
    "@hugocxl/vectors": "^0.1.11"
  }
}
