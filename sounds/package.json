{
  "name": "sounds-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @hugocxl/sounds build",
    "typecheck": "tsc -p packages/sounds --noEmit",
    "test": "pnpm run build && node scripts/sync-swift.mjs --check && node --test tests/*.test.mjs",
    "sync:swift": "pnpm run build && node scripts/sync-swift.mjs",
    "test:swift": "cd .. && swift test --filter SoundsTests",
    "build:site": "pnpm run build && node scripts/build-site.mjs",
    "dev": "pnpm run build:site && pnpm dlx serve _site -l 4321",
    "pack:check": "npm pack -w @hugocxl/sounds --dry-run"
  },
  "devDependencies": {
    "@hugocxl/design-system": "^0.2.10",
    "@hugocxl/icons": "^0.2.27",
    "@hugocxl/sounds": "workspace:*",
    "@hugocxl/vectors": "^0.1.11",
    "esbuild": "^0.28.2",
    "marked": "^15.0.12",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
